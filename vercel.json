{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "x-robots-tag",
                    "value": "index, follow"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap.xml"
        },
        {
            "source": "/sitemap-news.xml",
            "destination": "/api/sitemap-news.xml"
        },
        {
            "source": "/ads.txt",
            "destination": "/api/ads-txt"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}