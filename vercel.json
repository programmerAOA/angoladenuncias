{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "x-robots-tag",
                    "value": "index, follow"
                }
            ]
        },
        {
            "source": "/admin(.*)",
            "headers": [
                {
                    "key": "x-robots-tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/auth(.*)",
            "headers": [
                {
                    "key": "x-robots-tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "semfiltros.com"
                }
            ],
            "destination": "https://www.semfiltros.com/:path*",
            "permanent": true
        },
        {
            "source": "/mundo",
            "destination": "/internacional",
            "permanent": true
        },
        {
            "source": "/mundo/:slug*",
            "destination": "/internacional/:slug*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap.xml"
        },
        {
            "source": "/sitemap-index.xml",
            "destination": "/api/sitemap.xml"
        },
        {
            "source": "/sitemap-news.xml",
            "destination": "/api/sitemap-news.xml"
        },
        {
            "source": "/sitemap-articles.xml",
            "destination": "/api/sitemap-articles.xml"
        },
        {
            "source": "/sitemap-opinions.xml",
            "destination": "/api/sitemap-opinions.xml"
        },
        {
            "source": "/sitemap-static.xml",
            "destination": "/api/sitemap-static.xml"
        },
        {
            "source": "/ads.txt",
            "destination": "/api/ads-txt"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
